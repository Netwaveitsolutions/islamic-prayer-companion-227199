<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Needed on Android 13+ to show notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name="org.example.app.PrayerCompanionApp"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IslamicPrayerCompanion">

        <activity
            android:name="org.example.app.ui.onboarding.OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.IslamicPrayerCompanion" />

        <activity
            android:name="org.example.app.ui.settings.CityPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.IslamicPrayerCompanion" />

        <activity
            android:name="org.example.app.ui.prayer.SalahHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.IslamicPrayerCompanion" />

        <activity
            android:name="org.example.app.ui.qibla.QiblaActivity"
            android:exported="false"
            android:theme="@style/Theme.IslamicPrayerCompanion" />

        <activity
            android:name="org.example.app.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IslamicPrayerCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="org.example.app.prayer.notifications.PrayerAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
