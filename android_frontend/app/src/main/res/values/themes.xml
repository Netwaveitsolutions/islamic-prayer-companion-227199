<resources>
    <!--
      Ocean Professional theme:
      - Clean surfaces, subtle elevation
      - Blue primary + amber secondary accents
      - Standardized typography and widget styling across Views-based UI
    -->
    <style name="Theme.IslamicPrayerCompanion" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Brand colors -->
        <item name="colorPrimary">@color/ocean_primary</item>
        <item name="colorPrimaryVariant">@color/ocean_primary_dark</item>
        <item name="colorSecondary">@color/ocean_secondary</item>
        <item name="colorSecondaryVariant">@color/ocean_secondary_dark</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/ocean_background</item>
        <item name="colorSurface">@color/ocean_surface</item>

        <!-- Typography -->
        <item name="android:textColorPrimary">@color/ocean_text</item>
        <item name="android:textColorSecondary">@color/ocean_text_muted</item>

        <!-- System colors -->
        <item name="colorError">@color/ocean_error</item>

        <!-- Baseline component styling -->
        <item name="materialButtonStyle">@style/Widget.IslamicPrayerCompanion.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.IslamicPrayerCompanion.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.IslamicPrayerCompanion.Card</item>

        <item name="tabStyle">@style/Widget.IslamicPrayerCompanion.Tab</item>
        <item name="bottomNavigationStyle">@style/Widget.IslamicPrayerCompanion.BottomNav</item>

        <item name="checkboxStyle">@style/Widget.IslamicPrayerCompanion.CheckBox</item>
        <item name="editTextStyle">@style/Widget.IslamicPrayerCompanion.EditText</item>

        <!-- Typography defaults for TextView (screens can still override with textAppearance) -->
        <item name="textAppearanceHeadline6">@style/TextAppearance.IslamicPrayerCompanion.Title</item>
        <item name="textAppearanceBody2">@style/TextAppearance.IslamicPrayerCompanion.Body</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.IslamicPrayerCompanion.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
        <item name="rippleColor">@color/ocean_primary</item>
    </style>

    <style name="Widget.IslamicPrayerCompanion.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/outline_soft</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Cards -->
    <style name="Widget.IslamicPrayerCompanion.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <!-- Tabs -->
    <style name="Widget.IslamicPrayerCompanion.Tab" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorColor">@color/ocean_primary</item>
        <item name="tabSelectedTextColor">@color/ocean_text</item>
        <item name="tabTextColor">@color/ocean_text_muted</item>
        <item name="tabRippleColor">@color/ocean_primary</item>
    </style>

    <!-- Bottom navigation -->
    <style name="Widget.IslamicPrayerCompanion.BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/ocean_primary</item>
        <item name="itemTextColor">@color/ocean_text</item>
        <item name="elevation">8dp</item>
        <item name="android:background">@color/ocean_surface</item>
    </style>

    <!-- CheckBox -->
    <style name="Widget.IslamicPrayerCompanion.CheckBox" parent="Widget.MaterialComponents.CompoundButton.CheckBox">
        <item name="buttonTint">@color/ocean_primary</item>
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- EditText (used by CityPicker search, etc.) -->
    <style name="Widget.IslamicPrayerCompanion.EditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:textColorHint">@color/ocean_text_muted</item>
    </style>

    <!-- Typography -->
    <style name="TextAppearance.IslamicPrayerCompanion.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.IslamicPrayerCompanion.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ocean_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
</resources>
