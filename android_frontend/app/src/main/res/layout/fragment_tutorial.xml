<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Salah Tutorial"
            android:textAppearance="@style/TextAppearance.IslamicPrayerCompanion.Title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="1) Set your city in Settings.\n2) Check off each prayer after you complete it.\n3) Use the Qibla compass to align your direction.\n\nThis module is intentionally minimal in the demo build."
            android:textAppearance="@style/TextAppearance.IslamicPrayerCompanion.Body" />
    </LinearLayout>
</ScrollView>
